NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Admin Dashboard Access
ADMIN_EMAIL=technovastudio9
ADMIN_PASSWORD=TechnovaStudio009
ADMIN_JWT_SECRET=technova-studio-super-secret-jwt-key-2026-production

# Transactional Email Notification (Optional - Resend API)
