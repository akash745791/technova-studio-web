# TECHNOVA STUDIO Environment Variables
# Copy this file to .env.local and update with your real keys

# Production / Base URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Managed Backend (Optional for local dev, used for production persistence)
